local T = require("./T")
local Probe = require("../../src/shared/Remake/LatencyProbe")
T.describe("latency action gates", function()
	T.it("requires a still grounded baseline for 150 ms", function()
		T.eq(Probe.ready(0.1, 0, 0, true), false)
		T.eq(Probe.ready(0.2, 2, 0, true), false)
		T.eq(Probe.ready(0.2, 0, 1, true), false)
		T.eq(Probe.ready(0.2, 0, 0, false), false)
		T.eq(Probe.ready(0.2, 0, 0, true), true)
	end)
	T.it("supports only known movement and jump probes", function()
		T.eq(Probe.action("Space"), "jump")
		T.eq(Probe.action("ButtonA"), "jump")
		T.eq(Probe.action("W"), "forward")
		T.eq(Probe.action("A"), "left")
		T.eq(Probe.action("S"), "back")
		T.eq(Probe.action("D"), "right")
		T.eq(Probe.action("E"), nil)
	end)
	T.it("jump ignores horizontal motion and falling", function()
		T.eq(Probe.responded("jump", 1, 10, 0, false, true), false)
		T.eq(Probe.responded("jump", 0, 0, -10, true, false), false)
		T.eq(Probe.responded("jump", 0, 0, 10, false, false), false)
		T.eq(Probe.responded("jump", 0, 0, 10, true, false), true)
	end)
	T.it("movement requires displacement and velocity in the probed direction", function()
		T.eq(Probe.responded("forward", 0, 0, 10, true, false), false)
		T.eq(Probe.responded("forward", -1, -10, 0, false, true), false)
		T.eq(Probe.responded("forward", 0, 10, 0, false, true), false)
		T.eq(Probe.responded("forward", 1, 10, 0, false, true), true)
	end)
end)
return nil
